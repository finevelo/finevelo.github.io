---
// Shows the press image when one exists, otherwise an editorial line illustration
// in the category colour. Keeps a fixed 16:9 box (1200x675) so nothing shifts on load.
import { CATEGORIES, type CategoryKey } from '../site.config';

interface Props {
  category: CategoryKey;
  alt: string;
  src?: string;
  credit?: string;
  caption?: string;
  sourceUrl?: string;
  license?: { name: string; url: string };
  changes?: string;
  eager?: boolean;
  priority?: boolean;
  showCredit?: boolean;
}

const { category, alt, src, credit, caption, sourceUrl, license, changes, eager = false, priority = false, showCredit = false } = Astro.props;
const tone = CATEGORIES[category].tone;
const isMtb = category === 'mtb';
const isEbike = category === 'e-bike';
const isComponents = category === 'components';
const tyre = isMtb ? 20 : isEbike ? 14 : 8;
const gradId = `g-${category}`;
---

<figure class="art">
  {
    src ? (
      <img
        src={src}
        alt={alt}
        width="1200"
        height="675"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      <svg viewBox="0 0 1200 675" role="img" aria-label={alt} preserveAspectRatio="xMidYMid slice">
        <defs>
          <radialGradient id={gradId} cx="70%" cy="20%" r="90%">
            <stop offset="0" stop-color="#ffffff" stop-opacity="0.16" />
            <stop offset="1" stop-color="#000000" stop-opacity="0.22" />
          </radialGradient>
        </defs>
        <rect width="1200" height="675" fill={tone} />
        <rect width="1200" height="675" fill={`url(#${gradId})`} />
        <line x1="0" y1="586" x2="1200" y2="586" stroke="#fff" stroke-opacity="0.12" stroke-width="2" />
        <g fill="none" stroke="#f4f1ea" stroke-linecap="round" stroke-linejoin="round">
          {isComponents ? (
            <g transform="translate(600 337)">
              <circle r="230" stroke-width="18" stroke-opacity="0.9" />
              <circle r="200" stroke-width="3" stroke-opacity="0.5" />
              <circle r="26" stroke-width="6" />
              {Array.from({ length: 24 }, (_, i) => {
                const a = (i / 24) * Math.PI * 2;
                const off = i % 2 ? 0.18 : -0.18;
                return (
                  <line
                    x1={Math.cos(a + off) * 26}
                    y1={Math.sin(a + off) * 26}
                    x2={Math.cos(a) * 200}
                    y2={Math.sin(a) * 200}
                    stroke-width="2"
                    stroke-opacity="0.7"
                  />
                );
              })}
            </g>
          ) : (
            <g stroke-width="7">
              <circle cx="400" cy="430" r="150" stroke-width={tyre} stroke-opacity="0.95" />
              <circle cx="820" cy="430" r="150" stroke-width={tyre} stroke-opacity="0.95" />
              <circle cx="400" cy="430" r="118" stroke-width="2" stroke-opacity="0.35" />
              <circle cx="820" cy="430" r="118" stroke-width="2" stroke-opacity="0.35" />
              <path d="M400 430 L590 440 L545 240 Z" />
              <path d="M545 240 L770 250 L590 440" />
              <path d="M770 250 L785 305 L820 430" />
              <path d="M770 250 L760 215 L800 205" stroke-width="6" />
              <path d="M800 205 Q840 200 838 238 Q836 268 812 270" stroke-width="6" />
              <path d="M540 240 L528 200" stroke-width="6" />
              <path d="M488 196 L568 192" stroke-width="10" />
              <circle cx="590" cy="440" r="34" stroke-width="5" />
              {isEbike && <rect x="640" y="318" width="100" height="40" rx="10" transform="rotate(-54 690 338)" stroke-width="5" fill="#f4f1ea" fill-opacity="0.18" />}
              {isMtb && <path d="M785 305 L800 350" stroke-width="12" stroke-opacity="0.6" />}
            </g>
          )}
        </g>
        <text x="40" y="640" fill="#f4f1ea" fill-opacity="0.55" font-family="Inter Variable, sans-serif" font-size="18" letter-spacing="3">
          FINEVELO · ILLUSTRATION
        </text>
      </svg>
    )
  }
  {
    showCredit && (caption || credit) && (
      <figcaption>
        {caption && <span class="cap">{caption}</span>}
        {credit && (
          <span class="credit">
            {sourceUrl ? <a href={sourceUrl} rel="noopener" target="_blank">{credit}</a> : credit}
            {license && (
              <>
                {', '}
                <a href={license.url} rel="license noopener" target="_blank">{license.name}</a>
              </>
            )}
            {changes && `, ${changes}`}
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .art {
    margin: 0;
  }
  .art img,
  .art svg {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--chip);
  }
  figcaption {
    font-size: 13px;
    color: var(--muted);
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    line-height: 1.45;
  }
  .cap {
    color: var(--ink-2);
  }
  .credit {
    font-size: 12px;
  }
  figcaption a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
