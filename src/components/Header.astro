---
import { NAV, SITE } from '../site.config';

const path = Astro.url.pathname.replace(new RegExp(`^${import.meta.env.BASE_URL.replace(/\/$/, '')}`), '') || '/';
const today = new Date().toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Berlin',
});
---

<header class="masthead">
  <div class="wrap masthead__top">
    <p class="masthead__date">{today}</p>
    <a href="/" class="logo" aria-label={`${SITE.name} home`}>Finevelo</a>
    <div class="masthead__actions">
      <button class="theme" type="button" aria-label="Toggle dark mode" data-theme-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
      </button>
      <a href="/newsletter/" class="masthead__cta">The Edit</a>
    </div>
  </div>
  <p class="wrap masthead__tagline">{SITE.tagline}</p>
  <nav class="nav" aria-label="Main">
    <ul class="wrap">
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .masthead {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
  }
  .masthead__top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-top: 22px;
  }
  .masthead__date {
    margin: 0;
    font-size: 12.5px;
    color: var(--muted);
  }
  .logo {
    font-family: var(--serif);
    font-size: clamp(34px, 6vw, 58px);
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .masthead__actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
  }
  .theme {
    background: none;
    border: 1px solid var(--rule);
    color: var(--ink);
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    cursor: pointer;
  }
  .masthead__cta {
    font-size: 13px;
    font-weight: 600;
    background: var(--ink);
    color: var(--bg);
    padding: 9px 14px;
    border-radius: var(--radius);
  }
  .masthead__cta:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .masthead__tagline {
    text-align: center;
    margin: 8px auto 18px;
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
    font-size: 15px;
  }
  .nav {
    border-top: 1px solid var(--rule);
  }
  .nav ul {
    list-style: none;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 4px 26px;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }
  .nav ul::-webkit-scrollbar {
    display: none;
  }
  .nav a {
    display: block;
    padding: 13px 0 11px;
    font-size: 13.5px;
    font-weight: 600;
    border-bottom: 2px solid transparent;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    border-bottom-color: var(--accent);
  }
  @media (max-width: 720px) {
    .masthead__top {
      grid-template-columns: 1fr auto;
      padding-top: 16px;
    }
    .masthead__date,
    .masthead__tagline {
      display: none;
    }
    .logo {
      grid-row: 1;
      padding-bottom: 14px;
    }
    .masthead__actions {
      padding-bottom: 14px;
    }
    .nav ul {
      justify-content: flex-start;
    }
  }
</style>
