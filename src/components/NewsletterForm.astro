---
// The newsletter has no provider yet, so nothing is collected: no email field until sign-up is real.
// When a provider is connected, replace this with its form (POST to the provider, never GET to our own pages).
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={['nl', { 'nl--compact': compact }]}>
  <p class="nl__note">Sign-up opens at launch.</p>
  <a class="btn" href="/rss.xml">Follow via RSS</a>
</div>

<style>
  .nl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }
  .nl--compact {
    flex-direction: column;
    align-items: flex-start;
  }
  .nl__note {
    margin: 0;
    color: var(--ink-2);
  }
</style>
