---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string;
  noindex?: boolean;
}
const { title, description, kicker, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="wrap page">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{title}</h1>
    <div class="prose"><slot /></div>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 760px;
    padding-top: 44px;
  }
  h1 {
    font-size: clamp(38px, 5.5vw, 58px);
    margin: 6px 0 28px;
  }
</style>
