---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---

<BaseLayout title="The Edit – daily newsletter" description="Five things that mattered in high-end cycling today. One email every morning.">
  <section class="wrap nl">
    <p class="kicker">Daily newsletter</p>
    <h1>The Edit</h1>
    <p class="lede">Five things that mattered in high-end cycling today, with prices, weights and why it matters. One email, every morning at 7.</p>
    <NewsletterForm />
    <p class="meta">Free, starting with our launch. We collect no addresses before then.</p>
  </section>
</BaseLayout>


<style>
  .nl {
    max-width: 620px;
    display: grid;
    justify-items: center;
    padding-top: 72px;
    text-align: center;
  }
  h1 {
    font-size: clamp(54px, 9vw, 96px);
    font-style: italic;
    margin: 8px 0 16px;
  }
  .lede {
    font-family: var(--serif);
    font-size: 21px;
    color: var(--ink-2);
    margin: 0 0 28px;
  }
  .meta {
    margin-top: 14px;
  }
  .meta a {
    text-decoration: underline;
  }
</style>
